# ─────────────────────────────────────────────────────────────
# ZonoticWatch — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────

# GDELT news + Open-Meteo weather need no credentials — they work out of the box.

# Backend API base URL. When set, the dashboard loads the signal feed and
# the county map from the FastAPI backend. Leave blank to run fully offline
# on the seed data in src/data/surveillance.js.
VITE_API_BASE=http://localhost:8000

# AI Signal Analyzer — by default routes through the backend's `/analyze`
# proxy to Ollama Cloud when VITE_API_BASE is set, and falls back to a local
# Ollama otherwise. Set VITE_ANALYZER=local to force the on-device model
# (e.g. during dev against a backend that's pointed at production), or
# VITE_ANALYZER=cloud to force the proxy. Install Ollama from
# https://ollama.com then `ollama pull gemma4` for the local path.
VITE_ANALYZER=
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=gemma4:latest
