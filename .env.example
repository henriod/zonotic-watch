# ─────────────────────────────────────────────────────────────
# ZonoticWatch — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────

# GDELT news + Open-Meteo weather need no credentials — they work out of the box.

# Backend API base URL. When set, the dashboard loads the signal feed and
# the county map from the FastAPI backend. Leave blank to run fully offline
# on the seed data in src/data/surveillance.js.
VITE_API_BASE=http://localhost:8000

# AI Signal Analyzer — runs on a local Ollama model (no key, no cost).
# Optional; these are the defaults. Install Ollama from https://ollama.com
# then `ollama pull gemma4`.
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=gemma4:latest
