# ─────────────────────────────────────────────────────────────
# ZonoticWatch backend — environment variables
# Copy to `.env` for local (non-Docker) runs. docker-compose.yml sets
# these directly for the containers, so a `.env` is only needed when
# running `uvicorn`/the worker on the host.
# ─────────────────────────────────────────────────────────────

# Async SQLAlchemy DSN for Postgres/PostGIS.
DATABASE_URL=postgresql+asyncpg://zonotic:zonotic@localhost:5432/zonotic

# Temporal frontend service.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=zonoticwatch

# Comma-separated browser origins allowed by CORS (Vite dev + prod).
CORS_ORIGINS=http://localhost:5173

# Ingestion source config (used from Phase 1 step 4 onward).
GDELT_API_BASE=https://api.gdeltproject.org
APIFY_TOKEN=

# AI Signal Analyzer — backend proxies the browser's request to Ollama Cloud
# so the key never enters the JS bundle. Leave OLLAMA_API_KEY blank to disable
# the /analyze endpoint (frontend falls back to local Ollama when API_BASE
# is unset). Get a key at https://ollama.com.
OLLAMA_API_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma3:27b-cloud

# Auth (invite-only login; see docs/refresh-access-control.md Phase 3).
# SESSION_SECRET signs the session cookie — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# COOKIE_SECURE must be `true` in any HTTPS deployment, `false` for localhost.
# ADMIN_USERNAME / ADMIN_PASSWORD seed the first admin on initial startup
# when the users table is empty; subsequent edits do not affect existing users.
SESSION_SECRET=
COOKIE_SECURE=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
